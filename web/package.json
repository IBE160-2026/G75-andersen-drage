{
  "name": "torsa-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "samples": "tsx scripts/copy-samples.ts",
    "predev": "npm run samples",
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "npm run samples",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../proxy/openapi.json -o api/schema.d.ts",
    "export-passages": "tsx scripts/export-passages.ts",
    "evaluate": "tsx scripts/evaluate.ts"
  },
  "dependencies": {
    "htmlparser2": "12.0.0",
    "idb": "8.0.4",
    "mammoth": "1.13.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "unpdf": "2.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "21.0.4",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
